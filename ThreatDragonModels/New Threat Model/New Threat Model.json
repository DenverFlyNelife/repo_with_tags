            "id": "process-api",
            "data": {
              "type": "tm.Process",
              "name": "Backend API (FastAPI): \nперевод средств, история транзакций",
              "description": "Основной сервис, реализующий эндпоинты перевода между счетами и просмотра истории транзакций.",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": true,
              "isWebApplication": true,
              "privilegeLevel": "",
              "threats": [
                {
                  "id": "thr-04",
                  "title": "SQL Injection в crud.py (подтверждено Semgrep)",
                  "type": "Tampering",
                  "status": "Open",
                  "severity": "Critical",
                  "description": "Semgrep обнаружил конкатенацию строк с непроверенной переменной в SQL-запросе asyncpg (crud.py, строка 66, CWE-89). Позволяет атакующему модифицировать логику запроса и читать/изменять произвольные данные в БД.",
                  "mitigation": "Использовать только параметризованные запросы asyncpg ($1, $2, ...) или подготовленные выражения (Connection.prepare); запретить конкатенацию строк для построения SQL; добавить unit-тесты на инъекции."
                },
                {
                  "id": "thr-05",
                  "title": "IDOR на эндпоинтах перевода/истории транзакций",
                  "type": "Elevation Of Privilege",
                  "status": "Open",
                  "severity": "Critical",
                  "description": "Найдено вручную (пентест): при отсутствии проверки принадлежности счёта авторизованному пользователю, аутентифицированный клиент может подставить чужой account_id/transaction_id и получить доступ к чужим средствам/истории операций.",
                  "mitigation": "На уровне сервисного слоя проверять, что account_id принадлежит текущему пользователю (по claims из JWT/сессии) перед любой операцией чтения/записи; не полагаться только на фронтенд."
                },
                {
                  "id": "thr-06",
                  "title": "Отсутствие rate limiting на эндпоинте перевода",
                  "type": "Denial Of Service",
                  "status": "Open",
                  "severity": "Medium",
                  "description": "Без ограничения частоты запросов возможен исчерпывающий поток запросов к API, ведущий к исчерпанию пула соединений PostgreSQL/Redis и отказу в обслуживании.",
                  "mitigation": "Ввести rate limiting (per-user, per-IP) на уровне API-gateway или middleware, настроить лимиты пула соединений с алертингом."
                },
                {
                  "id": "thr-07",
                  "title": "Недостаточная валидация суммы перевода",
                  "type": "Tampering",
                  "status": "Open",
                  "severity": "High",
                  "description": "Отсутствие строгой валидации входных данных (отрицательные суммы, переполнение, дробные значения вне допустимой точности) может привести к некорректному начислению/списанию средств.",
                  "mitigation": "Строгая валидация через Pydantic-модели (положительные значения, максимум, фиксированная точность Decimal), проверка бизнес-инвариантов на уровне сервиса и БД (CHECK constraints)."
                }
              ]
            },
