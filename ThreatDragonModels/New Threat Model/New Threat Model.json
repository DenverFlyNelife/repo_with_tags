            "id": "store-redis",
            "data": {
              "type": "tm.Store",
              "name": "Redis (кеш / сессии)",
              "description": "Кеш и/или хранилище сессионных данных для ускорения ответов API.",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isALog": false,
              "isEncrypted": false,
              "isSigned": false,
              "storesCredentials": true,
              "storesInventory": false,
              "threats": [
                {
                  "id": "thr-11",
                  "title": "Redis без аутентификации, порт проброшен на хост",
                  "type": "Information Disclosure",
                  "status": "Open",
                  "severity": "Critical",
                  "description": "В docker-compose.yml Redis запущен без requirepass/ACL и с проброшенным на хост портом 6379 — любой, у кого есть сетевой доступ к хосту, может читать закешированные данные и сессионные токены.",
                  "mitigation": "Включить requirepass/ACL, TLS между API и Redis, убрать проброс порта на хост, оставить Redis только во внутренней docker-сети."
                },
                {
                  "id": "thr-12",
                  "title": "Подмена/порча кешированных сессионных данных",
                  "type": "Tampering",
                  "status": "Open",
                  "severity": "High",
                  "description": "Без аутентификации в Redis атакующий может изменить закешированные сессионные данные, что может привести к перехвату сессии другого пользователя.",
                  "mitigation": "Аутентификация Redis + сетевая изоляция (см. thr-11); подпись/проверка целостности критичных кешированных значений на стороне API."
                },
                {
                  "id": "thr-13",
                  "title": "Отказ в обслуживании через FLUSHALL/перегрузку Redis",
                  "type": "Denial Of Service",
                  "status": "Open",
                  "severity": "Medium",
                  "description": "Неаутентифицированный доступ позволяет выполнить деструктивные команды (FLUSHALL) или перегрузить Redis, что приведёт к деградации/отказу сервиса.",
                  "mitigation": "ACL с запретом опасных команд (rename-command), аутентификация, мониторинг аномальной активности."
                }
              ]
            }
          },
