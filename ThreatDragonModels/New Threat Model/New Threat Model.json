            "id": "actor-user",
            "data": {
              "type": "tm.Actor",
              "name": "Пользователь (клиент банка)",
              "description": "Аутентифицированный клиент, инициирующий переводы средств и просматривающий историю транзакций через веб/мобильное приложение.",
              "isTrustBoundary": false,
              "outOfScope": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "providesAuthentication": true,
              "threats": [
                {
                  "id": "thr-01",
                  "title": "Спуфинг пользователя через кражу/подбор токена сессии",
                  "type": "Spoofing",
                  "status": "Open",
                  "severity": "High",
                  "description": "Атакующий может выдать себя за легитимного пользователя, если токен сессии/JWT недостаточно защищён (слабая энтропия, отсутствие ротации, хранение в localStorage без httpOnly).",
                  "mitigation": "Использовать httpOnly/secure cookies или короткоживущие JWT с refresh-токенами, строгую политику CORS, MFA для операций перевода средств."
                },
                {
                  "id": "thr-02",
                  "title": "Репудиация операции перевода",
                  "type": "Repudiation",
                  "status": "Open",
                  "severity": "Medium",
                  "description": "Пользователь может отрицать факт инициирования перевода при отсутствии неизменяемого журнала аудита с привязкой к идентификатору сессии и времени.",
                  "mitigation": "Вести подписанный/защищённый от изменения журнал аудита (append-only) со всеми параметрами операции, IP, user-agent, идентификатором сессии."
                },
                {
                  "id": "thr-03",
                  "title": "Раскрытие учётных данных при передаче по каналу User -> API",
                  "type": "Information Disclosure",
                  "status": "Open",
                  "severity": "High",
