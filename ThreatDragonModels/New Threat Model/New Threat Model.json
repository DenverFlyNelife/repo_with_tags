            "id": "store-postgres",
            "data": {
              "type": "tm.Store",
              "name": "PostgreSQL (счета, транзакции)",
              "description": "Хранилище данных о счетах пользователей и истории транзакций.",
              "outOfScope": false,
              "isTrustBoundary": false,
              "reasonOutOfScope": "",
              "hasOpenThreats": true,
              "isALog": false,
              "isEncrypted": false,
              "isSigned": false,
              "storesCredentials": true,
              "storesInventory": false,
              "threats": [
                {
                  "id": "thr-08",
                  "title": "Модификация данных счетов через SQLi",
                  "type": "Tampering",
                  "status": "Open",
                  "severity": "Critical",
                  "description": "Со стороны хранилища тот же корень проблемы, что и thr-04: успешная SQLi даёт прямой доступ на чтение/запись/удаление данных о счетах и транзакциях.",
                  "mitigation": "См. thr-04 (параметризованные запросы); дополнительно — принцип наименьших привилегий для роли БД, используемой API (без DROP/ALTER)."
                },
                {
                  "id": "thr-09",
                  "title": "Слабые/дефолтные учётные данные БД",
                  "type": "Information Disclosure",
                  "status": "Open",
                  "severity": "High",
                  "description": "В docker-compose.yml используются дефолтные учётные данные (POSTGRES_PASSWORD=postgres, POSTGRES_USER=postgres), порт 5432 проброшен на хост — при доступе к хосту возможен прямой вход в БД.",
                  "mitigation": "Использовать секреты (Docker/K8s secrets, Vault), сложные уникальные пароли, не пробрасывать порт 5432 наружу без необходимости, ограничить доступ firewall/security group."
                },
                {
                  "id": "thr-10",
                  "title": "Недостаточное журналирование изменений в БД",
                  "type": "Repudiation",
                  "status": "Open",
                  "severity": "Medium",
                  "description": "Отсутствие аудиторского журнала на уровне БД (кто/когда изменил баланс счёта) затрудняет расследование инцидентов и опровержение спорных операций.",
                  "mitigation": "Включить логирование DML-операций для критичных таблиц (pgaudit / триггеры аудита), хранить историю изменений отдельно от оперативных данных."
                }
              ]
            }
          },
